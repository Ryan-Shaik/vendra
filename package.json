{
  "name": "vendra",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@vendra/db",
    "db:migrate": "npm run db:migrate --workspace=@vendra/db",
    "db:push": "npm run db:push --workspace=@vendra/db",
    "db:seed": "npm run db:seed --workspace=@vendra/db",
    "db:studio": "npm run db:studio --workspace=@vendra/db"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "typescript": "^5"
  }
}
